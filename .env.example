# Postgres (Neon). Leave unset locally to fall back to SQLite.
# Use Neon's POOLED connection string. postgres:// is auto-converted to postgresql+psycopg://
DATABASE_URL=

# Secret used to sign JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me-too

# Comma-separated emails allowed to trigger a manual refresh from the UI
ADMIN_EMAILS=
